@startuml
' Mis à jour le 19/11/2026 : deux modèles ML, alerte sur fraude prédite.
!pragma layout smetana
package "Frontend" {
  [Pages]
  [Components]
  [Services]
  [Hooks]
}

package "Backend" {
  [Authentication]
  [Transactions]
  [Alerts]
  [Dashboard]
  [Fraud Detection]
  [Audit]
  [Reports]
}

package "MachineLearning" {
  [Training]
  [Prediction]
  [Preprocessing]
  [Modèle carte] as MC
  [Modèle mobile money] as MM
}

database "PostgreSQL"

Frontend --> Backend
Backend --> PostgreSQL
Backend --> MachineLearning
[Fraud Detection] --> [Alerts] : fraude prédite\n(score ≥ seuil du modèle)
[Fraud Detection] --> MC : carte, en ligne, virement
[Fraud Detection] --> MM : mobile money
[Authentication] --> [Audit] : journalisation
@enduml
