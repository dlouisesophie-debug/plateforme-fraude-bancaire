@startuml
!include charte.iuml
' Mis à jour le 19/11/2026 d'après les modèles Django : famille du modèle ML, canal et type d'opération.
!pragma layout smetana

class User {
  id : int
  username : string
  first_name : string
  last_name : string
  email : string
  role : admin | analyst | agent
  login()
  logout()
}

class Transaction {
  id : int
  transaction_id : string
  amount : decimal
  channel : card | online | transfer | mobile_money
  operation_type : cash_in | cash_out | transfer | payment | debit
  merchant : string
  category : string
  device : string
  location : string
  timestamp : datetime
  status : pending | legitimate | fraudulent | under_review
  created_at : datetime
}

class Prediction {
  id : int
  fraud_probability : float
  prediction : boolean
  prediction_date : datetime
}

class Alert {
  id : int
  status : open | confirmed | rejected | resolved
  severity : low | medium | high | critical
  comment : string
  created_at : datetime
  resolved_at : datetime
}

class MLModel {
  id : int
  version : string
  famille : carte | mobile_money
  algorithm : string
  precision_score : float
  recall_score : float
  f1_score : float
  auc_roc : float
  trained_at : datetime
  is_active : boolean
  artifact_path : string
}

class Report {
  id : int
  title : string
  type : string
  period_start : date
  period_end : date
  file_path : string
  created_at : datetime
}

class AuditLog {
  id : int
  action : string
  ip_address : string
  details : json
  created_at : datetime
}

User "0..1" -- "0..*" Transaction : saisit >
Transaction "1" -- "0..1" Prediction : génère >
Prediction "1" -- "0..1" Alert : déclenche >
Alert "0..*" -- "0..1" User : traitée par >
Prediction "0..*" -- "1" MLModel : produite par >
User "0..1" -- "0..*" Report : génère >
User "0..1" -- "0..*" AuditLog : trace >

note right of Transaction
  under_review = fraude prédite :
  paiement suspendu jusqu'à la
  décision de l'analyste
end note
note right of MLModel
  Un seul modèle actif par famille
end note
@enduml
