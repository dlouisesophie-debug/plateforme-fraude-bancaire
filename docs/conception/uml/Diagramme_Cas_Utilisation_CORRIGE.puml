@startuml
' Mis à jour le 19/11/2026 : suspension temporaire du paiement, second modèle (mobile money), journal d'audit.
!pragma layout smetana
left to right direction

actor "Administrateur" as Admin
actor "Analyste Fraude" as Analyst
actor "Agent Financier" as Agent
actor "Système ML" as ML <<secondary>>

rectangle "XelWóor — plateforme de détection de la fraude aux paiements" {
  usecase "Se connecter\n(JWT)" as UC1
  usecase "Gérer les utilisateurs\net les rôles" as UC2
  usecase "Superviser les modèles ML\n(carte et mobile money)" as UC3
  usecase "Consulter tous\nles rapports" as UC4
  usecase "Consulter le\njournal d'audit" as UC14

  usecase "Consulter les alertes\n(paiements suspendus)" as UC5
  usecase "Examiner une transaction\nscorée" as UC6
  usecase "Statuer sur une fraude :\nconfirmer (paiement refusé)\nou rejeter (paiement libéré)" as UC7
  usecase "Annoter une transaction" as UC8

  usecase "Saisir/consulter une transaction\n(carte, en ligne, virement,\nmobile money)" as UC9
  usecase "Consulter l'historique\ndes transactions" as UC10
  usecase "Exporter des rapports" as UC11

  usecase "Scorer une transaction\n(modèle de sa famille)" as UC12
  usecase "Déclencher une alerte\net suspendre le paiement" as UC13
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC14

Analyst --> UC1
Analyst --> UC5
Analyst --> UC6
Analyst --> UC7
Analyst --> UC8

Agent --> UC1
Agent --> UC9
Agent --> UC10
Agent --> UC11

ML --> UC12
ML --> UC13

UC9 ..> UC12 : <<include>>
UC12 ..> UC13 : <<extend>>\n(si fraude prédite :\nscore ≥ seuil du modèle)
UC13 ..> UC5 : <<include>>
@enduml
