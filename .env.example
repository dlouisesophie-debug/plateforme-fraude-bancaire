# Facultatif pour docker compose (des valeurs par défaut existent).
# Copier en .env pour les surcharger — ne JAMAIS committer .env.
# En production (Render), ces variables sont définies dans render.yaml /
# le tableau de bord Render, pas dans un fichier.

# --- Django ---
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# True pour le développement local (runserver). docker compose l'ignore et
# lance toujours l'image de production (False) ; Render : False (render.yaml).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origines du frontend autorisées à appeler l'API (séparées par des virgules)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_DB=fraudguard
POSTGRES_USER=fraudguard
POSTGRES_PASSWORD=change-me
# localhost pour le runserver local ; docker compose impose « db » lui-même.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Sur Render : DATABASE_URL=postgresql://user:motdepasse@hote:5432/base (prioritaire)

# --- Modèle ML (runserver lancé depuis backend/ ; Docker/Render utilisent /app/ml_*) ---
ML_MODELS_DIR=../ml/models
ML_SRC_DIR=../ml/src

# --- Frontend (intégré au build React) ---
REACT_APP_API_URL=http://localhost:8000/api

# --- Règle métier ---
# Seuil de déclenchement d'alerte (probabilité de fraude, 0 à 1)
FRAUD_ALERT_THRESHOLD=0.7
