# Copier ce fichier en .env et remplir les valeurs reelles (jamais commit .env)

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=fraudguard
POSTGRES_USER=fraudguard
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend
REACT_APP_API_URL=http://localhost:8000/api

# Seuil de declenchement d'alerte (probabilite de fraude, 0 a 1)
FRAUD_ALERT_THRESHOLD=0.7
